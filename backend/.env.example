# Copy to backend/.env and fill in. Never commit the real file.

# --- LLM ---------------------------------------------------------------
# gemini (default) | openai | fake (offline, deterministic - for tests/demos without keys)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Default plan for new conversations: free | pro | premium (models per plan: app/plans.py)
DEFAULT_PLAN=pro
# Embedding-based fast intent classifier in front of the LLM router
FAST_CLASSIFIER=true
# Optional alternative provider
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_ROUTER_MODEL=gpt-5.4-mini

# --- Retrieval ---------------------------------------------------------
# gemini (multilingual embeddings) | hash (offline fallback)
EMBEDDING_PROVIDER=gemini

# --- Web research ------------------------------------------------------
# auto = Tavily when TAVILY_API_KEY is set, otherwise DuckDuckGo
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# --- Persistence (Firebase Firestore) ----------------------------------
STORAGE_BACKEND=firestore
FIREBASE_PROJECT_ID=demo-resume-chat
# Local emulator (npm run emulators from the repo root). Remove for a real project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# grpc (default) | rest - use rest on networks/machines where gRPC (HTTP/2) connections fail
FIRESTORE_TRANSPORT=grpc
# Real project: path to the service-account JSON downloaded from the Firebase console.
FIREBASE_CREDENTIALS=
